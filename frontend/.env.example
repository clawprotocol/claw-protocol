# REQUIRED for production LawDog: monitored inbox for privacy / data-rights (Privacy Policy → #privacy-contact; linked from Terms & footers).
# Set at Vite build time; omit in local dev if you accept a console-only operator warning on production builds.
# VITE_LAWDOG_PRIVACY_EMAIL=privacy@example.com

# LawDog affiliate payout display (optional overrides; backend uses CLAW_* for exports)
VITE_LAWDOG_PAYOUT_NETWORK=base
VITE_LAWDOG_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
VITE_LAWDOG_EXPLORER_TX_URL=https://basescan.org/tx/{tx_hash}
