# CLAW API — local development (copy to `.env` in the repo root; `backend/llm_router.py` loads it)
#
# --- Supabase Phase A (optional dashboard persistence) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI (required for premium full draft + LLM routes) ---
OPENAI_API_KEY=sk-...
# Optional model overrides; see backend/llm_router.py. Defaults: gpt-4o-mini (basic), gpt-4o (premium).
# Set these on Railway if you do not use the public defaults. Use a model id your OpenAI project
# actually exposes; unknown ids → HTTP 404 → `openai_model_not_found` in premium-full-draft logs.
# CLAW_LLM_MODEL_PREMIUM=gpt-4o
# CLAW_LLM_MODEL_PREMIUM_REGEN=gpt-4o
# CLAW_LLM_MODEL_BASIC=gpt-4.1-nano

# --- Deployment class (FAIL-CLOSED when unset/blank) ---
# Explicitly set one of: local | dev | test | staging | production | prod
# Unset/blank/unknown => production-like: test-auth headers disabled; commercial auth enforced.
# Local/test-auth requires: CLAW_ENVIRONMENT=local|dev|test
# CLAW_ENVIRONMENT=local
#
# Staging/production Supabase JWT — asymmetric JWKS (ES256 / ECC P-256):
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# JWKS is derived as: <issuer>/.well-known/jwks.json
# Optional override: SUPABASE_JWKS_URL=  (or CLAW_SUPABASE_JWKS_URL)
# Optional cache TTL seconds (30–3600, default 300): CLAW_SUPABASE_JWKS_CACHE_TTL_SEC=300
# Aliases: CLAW_SUPABASE_JWT_ISSUER / CLAW_SUPABASE_JWT_AUDIENCE
# Do NOT set SUPABASE_JWT_SECRET for staging/production (HS256 is rejected there).
# Local/dev/test only — opt-in HS256 shared secret (impossible in staging/production):
# CLAW_SUPABASE_JWT_HS256_LOCAL=1
# SUPABASE_JWT_SECRET=

# --- Recipient review / signer magic links (+ envelope attestation HMAC) ---
# Required when CLAW_ENVIRONMENT is `staging`, `production`, or `prod`:
#   missing/blank/fallback-derived secrets → 422 signing_token_secret_not_configured (no shared fallback).
# Local / dev / test only: if unset, the API may use a deterministic in-process fallback.
# Generate a long random secret, e.g. `openssl rand -hex 32`
# Alias: CLAW_SIGNING_TOKEN_SECRET
# CLAW_AGREEMENT_SIGNING_TOKEN_SECRET=
# Optional: require header X-Claw-Recipient-Link-Mint-Key on POST .../recipient-access-token
# CLAW_RECIPIENT_LINK_MINT_KEY=

# --- Browser CORS (required in production when CLAW_ENVIRONMENT is not local/dev/test) ---
# Comma-separated exact origins for your web app (Stripe return → premium-full-draft must receive ACAO on 4xx/5xx).
# CLAW_CORS_ALLOW_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com
# Optional suffix allowlist (staging): .up.railway.app is auto-allowed when CLAW_ENVIRONMENT=staging|qa|preview
# CLAW_CORS_ALLOW_ORIGIN_SUFFIXES=.up.railway.app

# --- VS01 / agreement document bytes (Railway) ---
# If CLAW_DOCUMENTS_DIR is unset or not writable, finalize_document also tries $CLAW_DATA_DIR/documents
# then ./artifacts/documents. Set CLAW_DATA_DIR to a persistent writable volume in production.

# --- Local / dev / test / staging: LawDog Pro full draft vs AI airlock ---
# The policy layer blocks *legal-sensitive* heuristics (e.g. "settlement", "attorney") from
# reaching OpenAI. That protects production; it can block normal drafting when your intake
# includes those words. In non-production only, set the flag below to run redaction +
# minimization, then call OpenAI (never weakens redaction; production never honors this).
# CLAW_ALLOW_EXTERNAL_AI_LOCAL=1

# --- Commercial entitlement (Genesis complimentary monthly agreement creations) ---
# Active Genesis Dogs get a UTC-calendar-month draft-create allowance (not Stripe Pro).
# Metered event: successful new agreement_owner insert (abandoned drafts count).
# Accepted range: integer 1–100 inclusive. Default when unset/blank/invalid/0/negative/>100: 5.
# Zero is NOT a kill-switch — out-of-range values always fall back to 5.
# Affiliate commission ($11.70/mo = 30% of $39) is separate economics — do not use this for that.
# CLAW_GENESIS_MONTHLY_AGREEMENT_ALLOWANCE=5
