{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BundleV0",
  "type": "object",
  "required": ["schema", "bundle_id", "hashed", "hashes"],
  "properties": {
    "schema": { "type": "string" },
    "bundle_id": { "type": "string" },
    "hashed": {
      "type": "object",
      "required": ["created_at", "timeline", "evidence"],
      "properties": {
        "created_at": { "type": "string" },
        "timeline": {
          "type": "object",
          "required": ["timeline_id", "frozen_manifest_sha256", "path"],
          "properties": {
            "timeline_id": { "type": "string" },
            "frozen_manifest_sha256": { "type": "string" },
            "path": { "type": "string" }
          },
          "additionalProperties": false
        },
        "attestations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256", "type"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string" },
              "type": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "agreement_ref": {
          "type": ["object", "null"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string" }
          },
          "additionalProperties": false
        },
        "analysis_ref": {
          "type": ["object", "null"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string" }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256", "type"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string" },
              "type": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "hashes": {
      "type": "object",
      "required": ["sha256"],
      "properties": {
        "sha256": { "type": "string" }
      },
      "additionalProperties": false
    },
    "manifests": {
      "type": "object",
      "properties": {
        "sha256": { "type": "string" }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "ordering": {
      "type": "object",
      "properties": {
        "canonical_json": { "type": "string" },
        "sort_keys": { "type": "boolean" },
        "separators": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
