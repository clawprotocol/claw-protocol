{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DisputePacket",
  "type": "object",
  "required": ["schema", "packet_id", "created_at", "claims", "references"],
  "properties": {
    "schema": { "type": "string" },
    "packet_id": { "type": "string" },
    "created_at": { "type": "string" },
    "claims": {
      "type": "array",
      "items": { "type": "string" }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path", "sha256"],
        "properties": {
          "type": { "type": "string" },
          "id": { "type": "string" },
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "timelines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timeline_id", "receipt_id", "commitment"],
        "properties": {
          "timeline_id": { "type": "string" },
          "receipt_id": { "type": "string" },
          "commitment": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
